{
  "schemaVersion": 1,
  "id": "forecheck212",
  "name": "2-1-2 aggressive forecheck",
  "_notes": "F1 pressures the carrier, F2 takes away the weak-side reverse low, F3 holds the high slot, the D pinch at the offensive blue line. Neutral zone: F1 and F2 keep pressing. Own zone: F1 on the puck, F2 high slot, F3 weak-side point, D1 puck-side low, D2 net front. One player per team per node (D-058): when the puck sits where a teammate's fixed target is, a puckX/puckY rule moves that teammate: offensive zone D1 holds the line at (6,1) or F3 drops to (6,2); neutral zone D1 stands up at (3,0) and F2 trails straight behind F1 on the centre lane; own zone D1 drops to the strong-side post (1,1), D2 to the weak-side post (1,3) or F2 slides to (3,1).",
  "mirrorY": true,
  "rules": [
    {
      "when": {
        "puckX": [7, 7],
        "puckY": [1, 1]
      },
      "targets": {
        "F1": {
          "puckOffset": [0, 0]
        },
        "F2": {
          "node": [9, 3]
        },
        "F3": {
          "node": [7, 2]
        },
        "D1": {
          "node": [6, 1]
        },
        "D2": {
          "node": [6, 3]
        }
      }
    },
    {
