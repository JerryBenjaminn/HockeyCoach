          "puckOffset": [-1, 1]
        },
        "F2": {
          "node": [4, 1]
        },
        "F3": {
          "node": [4, 3]
        },
        "D1": {
          "node": [3, 0]
        },
        "D2": {
          "node": [3, 3]
        }
      }
    },
    {
      "when": {
        "puckX": [5, 5],
