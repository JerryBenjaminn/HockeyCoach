# Crashlytics ja käännöstulosteet
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Addressables ja StreamingAssets-generoinnit
/unity/HockeyCoach/[Aa]ssets/[Ss]treamingAssets/aa.meta
/unity/HockeyCoach/[Aa]ssets/[Ss]treamingAssets/aa/*

