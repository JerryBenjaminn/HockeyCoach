<Project>
  <!--
    Shared build settings for the .NET projects under src/, tools/ and tests/.
    Guarded by path so that IDE projects generated by Unity under unity/ are not affected.
  -->
  <PropertyGroup>
    <_HcRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</_HcRoot>
    <_HcProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_HcProjectDir>
    <IsHockeyCoachProject Condition="$(_HcProjectDir.StartsWith('$(_HcRoot)src')) Or $(_HcProjectDir.StartsWith('$(_HcRoot)tools')) Or $(_HcProjectDir.StartsWith('$(_HcRoot)tests'))">true</IsHockeyCoachProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsHockeyCoachProject)' == 'true'">
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Company>HockeyCoach</Company>
    <Product>HockeyCoach</Product>
  </PropertyGroup>

  <!--
    Sim and AI (netstandard2.1) pin LangVersion 9 / Nullable disable / ImplicitUsings disable
    in their own csproj files, because TargetFramework is not yet known when this file is evaluated.
  -->
</Project>
